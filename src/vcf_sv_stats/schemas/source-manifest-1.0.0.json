{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcf-sv-stats:schema:source-manifest:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "combined_sha256", "sources"],
  "properties": {
    "schema_name": {"const": "vcf-sv-stats.source-manifest"},
    "schema_version": {"const": "1.0.0"},
    "combined_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["producer_label", "path", "display_name", "sha256", "artifact_role", "adapter_id", "record_namespace", "merger_provenance"],
        "properties": {
          "producer_label": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
          "path": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact_role": {"enum": ["caller_native", "caller_normalized", "merger_input", "comparison_source"]},
          "adapter_id": {
            "anyOf": [
              {"const": "generic"},
              {"type": "string", "pattern": "^urn:vcf-sv-stats:adapter:[a-z0-9._-]+:1$"}
            ]
          },
          "record_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
          "index": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "display_name", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "display_name": {"type": "string", "pattern": "^[^/\\\\]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "merger_provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id_fields", "relationship_fields"],
            "properties": {
              "support_ordinal": {"type": "integer", "minimum": 0},
              "source_id_fields": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[A-Za-z_][0-9A-Za-z_.]*$"},
                "uniqueItems": true
              },
              "relationship_fields": {
                "type": "array",
                "items": {"enum": ["MATEID", "PARID", "EVENT"]},
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
